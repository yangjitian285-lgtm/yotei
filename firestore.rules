rules_version = '2';

// ============================================================
//  よてい — Firestore セキュリティルール
//  基本方針:
//   ・メール確認が済んだログインユーザーしか何も読めない/書けない
//   ・「自分だけ」の予定は users/{自分}/ にあり、本人以外は絶対に読めない
//   ・共有データは couples/{ペアID}/ にあり、共有している2人以外は読めない
//     (共有していない人は users/{自分}/ だけを使う)
//   ・ペアは「本人が発行した期限付き招待コード」がないと作れない
//   ・ペアのメンバーは後から書き換え不可(第三者の割り込み防止)
//   ・すべての書き込みで項目名・型・文字数をチェック
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.uid; }
    function data() { return request.resource.data; }
    function str(v, max) { return v is string && v.size() <= max; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isTime(v) { return v is string && (v == '' || v.matches('^[0-9]{2}:[0-9]{2}$')); }
    function isColor(v) { return v is string && v.matches('^#[0-9a-fA-F]{6}$'); }
    function couplePath(cid) { return /databases/$(database)/documents/couples/$(cid); }
    function isMember(cid) {
      return signedIn() && exists(couplePath(cid)) && me() in get(couplePath(cid)).data.members;
    }
    function validProfile(p) {
      return p is map && p.keys().hasOnly(['name', 'color']) && str(p.name, 20) && isColor(p.color);
    }

    // ---- 予定の共通チェック ----
    function validEventBase(eid) {
      return data().keys().hasOnly(['id', 'title', 'startDate', 'endDate', 'allDay', 'startTime', 'endTime',
                                    'owner', 'visibility', 'place', 'note', 'createdBy', 'updatedBy', 'updatedAt'])
        && data().id == eid
        && str(data().title, 100) && str(data().place, 100) && str(data().note, 1000)
        && isDate(data().startDate) && isDate(data().endDate) && data().endDate >= data().startDate
        && data().allDay is bool && isTime(data().startTime) && isTime(data().endTime)
        && data().updatedBy == me() && data().updatedAt is number
        && data().createdBy is string && data().owner is string;
    }

    // ---- 自分のプロフィールと「自分だけ」の予定 ----
    match /users/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && data().keys().hasOnly(['name', 'color', 'lastSeenAt'])
        && (!('name' in data()) || str(data().name, 20))
        && (!('color' in data()) || isColor(data().color))
        && (!('lastSeenAt' in data()) || data().lastSeenAt is number);

      match /events/{eid} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid && validEventBase(eid)
          && data().owner == uid && data().visibility in ['private', 'busy'];
      }

      match /anniversaries/{aid} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && data().keys().hasOnly(['id', 'title', 'date', 'yearly'])
          && data().id == aid && str(data().title, 50) && isDate(data().date) && data().yearly is bool;
      }
    }

    // ---- 招待コード(8文字・30分で失効・1回使い切り) ----
    match /invites/{code} {
      // コードを知っている人だけが1件だけ取得できる(一覧取得は禁止)
      allow get: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{8}$');
      allow list, update: if false;
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && data().keys().hasOnly(['from', 'profile', 'createdAt', 'expiresAt'])
        && data().from == me() && validProfile(data().profile)
        && data().expiresAt is number
        && data().expiresAt <= request.time.toMillis() + 31 * 60 * 1000;
      // 発行者・ペアになった相手・期限切れのときだけ削除できる
      allow delete: if signedIn() && (
        resource.data.from == me()
        || resource.data.expiresAt < request.time.toMillis()
        || exists(couplePath(resource.data.from + '_' + me()))
        || exists(couplePath(me() + '_' + resource.data.from)));
    }

    // ---- ペア(2人の共有スペース) ----
    match /couples/{cid} {
      function invite() { return get(/databases/$(database)/documents/invites/$(data().inviteCode)).data; }

      allow read: if signedIn() && me() in resource.data.members;

      allow create: if signedIn()
        && data().keys().hasOnly(['members', 'inviteCode', 'profiles', 'startDate', 'createdAt'])
        && data().members is list && data().members.size() == 2
        && data().members[0] < data().members[1]
        && cid == data().members[0] + '_' + data().members[1]
        && me() in data().members
        && data().inviteCode is string
        && exists(/databases/$(database)/documents/invites/$(data().inviteCode))
        && invite().from in data().members
        && invite().from != me()
        && invite().expiresAt > request.time.toMillis()
        && data().profiles.keys().hasOnly(data().members)
        && data().startDate == '';

      // 変更できるのは「自分のプロフィール」と「付き合った日」だけ
      allow update: if signedIn() && me() in resource.data.members
        && data().diff(resource.data).affectedKeys().hasOnly(['profiles', 'startDate'])
        && data().profiles.diff(resource.data.profiles).affectedKeys().hasOnly([me()])
        && validProfile(data().profiles[me()])
        && (data().startDate == '' || isDate(data().startDate));

      allow delete: if signedIn() && me() in resource.data.members;

      // 共有の予定
      match /events/{eid} {
        allow read: if isMember(cid);
        allow create, update: if isMember(cid) && validEventBase(eid)
          && (data().owner == 'both' || data().owner in get(couplePath(cid)).data.members)
          && (
            data().visibility == 'shared'
            // 「予定ありだけ見せる」の目隠しデータ: 本人しか作れず、中身は空でなければならない
            || (data().visibility == 'busy' && data().owner == me()
                && data().title == '' && data().place == '' && data().note == '')
          )
          // 相手の「予定あり」目隠しデータは書き換えられない
          && (resource == null || resource.data.visibility == 'shared' || resource.data.owner == me());
        // 削除はペアのどちらでも可(ペア解除時の一括削除のため。目隠しデータは中身が空なので漏れる情報はない)
        allow delete: if isMember(cid);
      }

      // 記念日
      match /anniversaries/{aid} {
        allow read, delete: if isMember(cid);
        allow create, update: if isMember(cid)
          && data().keys().hasOnly(['id', 'title', 'date', 'yearly'])
          && data().id == aid && str(data().title, 50) && isDate(data().date) && data().yearly is bool;
      }

      // 更新履歴(相手への通知)。追記のみ・なりすまし不可
      match /activity/{actId} {
        allow read, delete: if isMember(cid);
        allow create: if isMember(cid)
          && data().keys().hasOnly(['id', 'by', 'type', 'title', 'date', 'at'])
          && data().id == actId && data().by == me()
          && data().type in ['add', 'edit', 'delete']
          && str(data().title, 100) && isDate(data().date) && data().at is number;
        allow update: if false;
      }
    }
  }
}
